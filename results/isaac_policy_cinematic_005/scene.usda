    }

    def Xform "Spot" (
        prepend references = @https://omniverse-content-production.s3-us-west-2.amazonaws.com/Assets/Isaac/6.0/Isaac/Robots/BostonDynamics/spot/spot.usd@
    )
    {
        quatd xformOp:orient = (1, 0, 0, 0)
        double3 xformOp:translate = (0, 0, 0.8)
        uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

        over "body"
        {
            def Camera "drishti_left"
            {
                float2 clippingRange = (0.05, 60)
                float focalLength = 24
                float horizontalAperture = 36.6
                float verticalAperture = 27.449999
                quatd xformOp:orient = (0.6532815098762512, -0.27059805393218994, -0.27059805393218994, 0.6532815098762512)
                double3 xformOp:scale = (1, 1, 1)
                double3 xformOp:translate = (0.3199999928474426, 0.05999999865889549, 0.15000000596046448)
                uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]
            }

            def Camera "drishti_right"
            {
                float2 clippingRange = (0.05, 60)
                float focalLength = 24
